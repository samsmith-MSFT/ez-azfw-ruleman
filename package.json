{
  "name": "ez-azfw-ruleman",
  "productName": "EZ AzFW Rule Manager",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app for managing Azure Firewall policy rules with a draft, review and commit workflow",
  "keywords": [
    "azure",
    "azure-firewall",
    "firewall-policy",
    "firewall-rules",
    "network-security",
    "electron",
    "desktop-app",
    "devops"
  ],
  "license": "MIT",
  "author": "samsmith-MSFT",
  "homepage": "https://github.com/samsmith-MSFT/ez-azfw-ruleman#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samsmith-MSFT/ez-azfw-ruleman.git"
  },
  "bugs": {
    "url": "https://github.com/samsmith-MSFT/ez-azfw-ruleman/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "dist": "node scripts/dist.mjs",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "verify": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.90.0",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@azure/arm-network": "^39.1.0",
    "@azure/arm-resourcegraph": "^5.0.0",
    "@azure/arm-resources": "^8.0.0",
    "@azure/arm-resourcesdeployments": "^2.0.0",
    "@azure/identity": "^4.14.0",
    "@azure/msal-node": "^7.1.2",
    "@fontsource-variable/atkinson-hyperlegible-mono": "^5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "lucide-react": "^1.64.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
